generator client {
  provider = "prisma-client"
  output = "../src/modules/identity/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas = ["identity", "courses", "enrollments", "assessments", "grading", "audit", "exams", "collaboration", "analytics", "submissions", "plagiarism"]
}
generator courseClient {
  provider = "prisma-client"
  output = "../src/modules/courses/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
generator enrollmentClient {
  provider = "prisma-client"
  output = "../src/modules/enrollments/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

generator assessmentClient {
  provider = "prisma-client"
  output = "../src/modules/assessments/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
generator gradingClient {
  provider = "prisma-client"
  output = "../src/modules/grading/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
generator auditClient {
  provider = "prisma-client"
  output = "../src/modules/audit/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

// Phase 4: question banks, assessment definitions and frozen question snapshots (CAR-04).
model QuestionBank {
  id String @id @db.Uuid
  courseId String @db.Uuid
  name String @db.VarChar(160)
  createdAt DateTime @db.Timestamptz(3)
  questions Question[]
  @@unique([courseId, name])
  @@map("banks")
  @@schema("assessments")
}
model Question {
  id String @id @db.Uuid
  bankId String @db.Uuid
  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type String @db.VarChar(12)
  statement String
  pointsCents Int
  options Json
  active Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @db.Timestamptz(3)
  @@index([bankId])
  @@map("questions")
  @@schema("assessments")
}
model Assessment {
  id String @id @db.Uuid
  courseId String @db.Uuid
  title String @db.VarChar(160)
  instructions String
  type String @db.VarChar(10)
  weightBp Int
  dueAt DateTime @db.Timestamptz(3)
  durationMinutes Int?
  questionCount Int?
  bankId String? @db.Uuid
  criteria Json
  status String @db.VarChar(10)
  revision Int @default(0)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3)
  snapshot SnapshotQuestion[]
  @@index([courseId])
  @@map("assessments")
  @@schema("assessments")
}
model SnapshotQuestion {
  assessmentId String @db.Uuid
  assessment Assessment @relation(fields: [assessmentId], references: [id])
  questionId String @db.Uuid
  position Int
  type String @db.VarChar(12)
  statement String
  pointsCents Int
  options Json
  @@id([assessmentId, questionId])
  @@map("snapshot_questions")
  @@schema("assessments")
}

// Phase 4: LMS grades (not the official registry). Every insert/update is audited by trigger (CAR-12).
model Grade {
  id String @id @db.Uuid
  assessmentId String @db.Uuid
  courseId String @db.Uuid
  studentId String @db.Uuid
  scoreCents Int
  origin String @db.VarChar(10)
  detail Json
  reason String
  gradedBy String @db.Uuid
  gradedAt DateTime @db.Timestamptz(3)
  version Int @default(0)
  @@unique([assessmentId, studentId])
  @@index([courseId, studentId])
  @@map("grades")
  @@schema("grading")
}

// Phase 4: append-only, hash-chained audit log (CAR-12, EAC-04). Written only through audit.append_entry.
model AuditEntry {
  id BigInt @id @default(autoincrement())
  entity String @db.VarChar(40)
  entityId String @db.Uuid
  action String @db.VarChar(10)
  before Json?
  after Json?
  actorId String @db.Uuid
  occurredAt DateTime @db.Timestamptz(6)
  prevHash String @db.Char(64)
  hash String @unique @db.Char(64)
  @@index([entity, entityId])
  @@map("entries")
  @@schema("audit")
}

generator examClient {
  provider = "prisma-client"
  output = "../src/modules/exams/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
// Phase 5: timed attempts (CU-03), versioned idempotent answers (CAR-11) and the transactional outbox.
model ExamAttempt {
  id String @id @db.Uuid
  assessmentId String @db.Uuid
  courseId String @db.Uuid
  studentId String @db.Uuid
  status String @db.VarChar(12)
  startedAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  finalizedAt DateTime? @db.Timestamptz(3)
  finalizedBy String? @db.VarChar(10)
  questions Json
  answers ExamAnswer[]
  @@unique([assessmentId, studentId])
  @@index([status, expiresAt])
  @@map("attempts")
  @@schema("exams")
}
model ExamAnswer {
  attemptId String @db.Uuid
  attempt ExamAttempt @relation(fields: [attemptId], references: [id])
  questionId String @db.Uuid
  optionIds Json
  version BigInt
  savedAt DateTime @db.Timestamptz(3)
  @@id([attemptId, questionId])
  @@map("answers")
  @@schema("exams")
}
model ExamOutbox {
  id String @id @db.Uuid
  type String @db.VarChar(40)
  aggregateId String @db.Uuid
  payload Json
  createdAt DateTime @db.Timestamptz(3)
  availableAt DateTime @db.Timestamptz(3)
  attempts Int @default(0)
  processedAt DateTime? @db.Timestamptz(3)
  lastError String? @db.VarChar(200)
  @@index([processedAt, availableAt])
  @@map("outbox")
  @@schema("exams")
}

generator collaborationClient {
  provider = "prisma-client"
  output = "../src/modules/collaboration/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
generator analyticsClient {
  provider = "prisma-client"
  output = "../src/modules/analytics/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}

// Phase 8: forums per course/unit, threads, messages, subscriptions (Observer) and the in-app notification inbox (CAR-07).
model Forum {
  id String @id @db.Uuid
  courseId String @db.Uuid
  unitId String? @db.Uuid
  title String @db.VarChar(160)
  description String
  createdBy String @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  threads ForumThread[]
  @@index([courseId])
  @@map("forums")
  @@schema("collaboration")
}
model ForumThread {
  id String @id @db.Uuid
  forumId String @db.Uuid
  forum Forum @relation(fields: [forumId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  title String @db.VarChar(160)
  pinned Boolean @default(false)
  locked Boolean @default(false)
  createdAt DateTime @db.Timestamptz(3)
  lastActivityAt DateTime @db.Timestamptz(3)
  messages ForumMessage[]
  subscriptions ThreadSubscription[]
  @@index([forumId, lastActivityAt])
  @@map("threads")
  @@schema("collaboration")
}
model ForumMessage {
  id String @id @db.Uuid
  threadId String @db.Uuid
  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  body String
  createdAt DateTime @db.Timestamptz(3)
  hidden Boolean @default(false)
  hiddenBy String? @db.Uuid
  hiddenReason String? @db.VarChar(500)
  @@index([threadId, createdAt])
  @@map("messages")
  @@schema("collaboration")
}
model ThreadSubscription {
  threadId String @db.Uuid
  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId String @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  @@id([threadId, userId])
  @@index([userId])
  @@map("subscriptions")
  @@schema("collaboration")
}
model Notification {
  id String @id @db.Uuid
  userId String @db.Uuid
  type String @db.VarChar(30)
  title String @db.VarChar(200)
  body String @db.VarChar(1000)
  link Json
  dedupeKey String? @unique @db.VarChar(200)
  createdAt DateTime @db.Timestamptz(3)
  readAt DateTime? @db.Timestamptz(3)
  @@index([userId, readAt, createdAt])
  @@map("notifications")
  @@schema("collaboration")
}

// Phase 8: connection time and configurable risk rules (CAR-08; rules only, no ML).
model ActivityDay {
  userId String @db.Uuid
  courseId String @db.Uuid
  day DateTime @db.Date
  minutes Int @default(0)
  lastSeenAt DateTime @db.Timestamptz(3)
  @@id([userId, courseId, day])
  @@index([courseId, day])
  @@map("activity")
  @@schema("analytics")
}
model RiskRule {
  courseId String @id @db.Uuid
  minProgress Int
  minAverageCents Int
  maxInactiveDays Int
  maxMissed Int
  updatedBy String @db.Uuid
  updatedAt DateTime @db.Timestamptz(3)
  @@map("risk_rules")
  @@schema("analytics")
}

// Local projection of the Academic Registry roster (CAR-09 source of truth stays external).
model Enrollment {
  studentId String @db.Uuid
  courseId String @db.Uuid
  active Boolean @default(true)
  updatedAt DateTime @db.Timestamptz(3)
  @@id([studentId, courseId])
  @@index([courseId, active])
  @@map("enrollments")
  @@schema("enrollments")
}
model EnrollmentRun {
  id String @id @db.Uuid
  courseId String @db.Uuid
  actorId String @db.Uuid
  source String @db.VarChar(40)
  added Int
  removed Int
  total Int
  occurredAt DateTime @db.Timestamptz(3)
  @@index([courseId, occurredAt])
  @@map("runs")
  @@schema("enrollments")
}
// Part A: registry section linked to each course and nightly synchronization runs (CAR-09).
model RegistrySection {
  courseId String @id @db.Uuid
  code String @db.VarChar(40)
  period String @db.VarChar(40)
  updatedAt DateTime @db.Timestamptz(3)
  @@index([code, period])
  @@map("sections")
  @@schema("enrollments")
}
model RegistrySyncRun {
  id String @id @db.Uuid
  trigger String @db.VarChar(10)
  slot String? @unique(map: "sync_runs_slot_key") @db.VarChar(40)
  actorId String @db.Uuid
  status String @db.VarChar(10)
  startedAt DateTime @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  sections Int @default(0)
  added Int @default(0)
  removed Int @default(0)
  unknown Int @default(0)
  skipped Int @default(0)
  retries Int @default(0)
  error String? @db.VarChar(200)
  @@index([startedAt])
  @@map("sync_runs")
  @@schema("enrollments")
}

enum CourseStatus {
  BORRADOR
  EN_REVISION
  PUBLICADO
  ARCHIVADO
  @@schema("courses")
}
model Course {
  id String @id @db.Uuid
  code String @db.VarChar(40)
  name String @db.VarChar(160)
  description String
  period String @db.VarChar(40)
  teacherId String @db.Uuid
  syllabus String @default("")
  status CourseStatus @default(BORRADOR)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  units CourseUnit[]
  reviews CourseReview[]
  changes CourseChange[]
  completions ContentCompletion[]
  @@unique([code, period])
  @@index([teacherId, status])
  @@map("courses")
  @@schema("courses")
}
model CourseUnit {
  id String @id @db.Uuid
  courseId String @db.Uuid
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  position Int
  sessions CourseSession[]
  @@unique([courseId, position])
  @@map("units")
  @@schema("courses")
}
model CourseSession {
  id String @id @db.Uuid
  unitId String @db.Uuid
  unit CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  description String
  durationMinutes Int @default(0)
  position Int
  materials CourseMaterial[]
  @@unique([unitId, position])
  @@map("sessions")
  @@schema("courses")
}
model CourseMaterial {
  id String @id @db.Uuid
  sessionId String @db.Uuid
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title String @db.VarChar(160)
  position Int
  versions MaterialVersion[]
  @@unique([sessionId, position])
  @@map("materials")
  @@schema("courses")
}
model MaterialVersion {
  id String @id @db.Uuid
  materialId String @db.Uuid
  material CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  number Int
  kind String @db.VarChar(10)
  filename String?
  mimeType String?
  storageKey String? @unique
  size Int?
  sha256 String? @db.VarChar(64)
  url String?
  authorId String @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  completions ContentCompletion[]
  @@unique([materialId, number])
  @@map("material_versions")
  @@schema("courses")
}
model CourseReview {
  id String @id @db.Uuid
  courseId String @db.Uuid
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  decision String @db.VarChar(20)
  observations String
  revision Int
  createdAt DateTime @db.Timestamptz(3)
  @@index([courseId, createdAt])
  @@map("reviews")
  @@schema("courses")
}
model CourseChange {
  id String @id @db.Uuid
  courseId String @db.Uuid
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  revision Int
  actorId String @db.Uuid
  action String @db.VarChar(40)
  detail Json
  createdAt DateTime @db.Timestamptz(3)
  @@index([courseId, createdAt])
  @@map("changes")
  @@schema("courses")
}
model ContentCompletion {
  userId String @db.Uuid
  courseId String @db.Uuid
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materialId String @db.Uuid
  versionId String @db.Uuid
  version MaterialVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([userId, versionId])
  @@index([userId, courseId])
  @@map("completions")
  @@schema("courses")
}

enum Role {
  STUDENT
  TEACHER
  INSTRUCTIONAL_DESIGNER
  ADMIN
  @@schema("identity")
}

model User {
  id String @id @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(100)
  passwordHash String
  role Role
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  active Boolean @default(true)
  version Int @default(0)
  sessions Session[]
  recoveries PasswordRecovery[]
  messages RecoveryMessage[]
  @@map("users")
  @@schema("identity")
}

model Session {
  id String @id @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}
model PasswordRecovery {
  tokenHash String @id @db.VarChar(64)
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  @@index([userId])
  @@map("password_recoveries")
  @@schema("identity")
}
model RecoveryMessage {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload String
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  deliveredAt DateTime? @db.Timestamptz(3)
  @@index([deliveredAt, availableAt])
  @@map("recovery_messages")
  @@schema("identity")
}
model SecurityEvent {
  id String @id @db.Uuid
  action String @db.VarChar(40)
  actorId String? @db.Uuid
  userId String? @db.Uuid
  occurredAt DateTime @db.Timestamptz(3)
  @@index([occurredAt])
  @@map("security_events")
  @@schema("identity")
}

generator submissionClient {
  provider = "prisma-client"
  output = "../src/modules/submissions/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
generator plagiarismClient {
  provider = "prisma-client"
  output = "../src/modules/plagiarism/infrastructure/persistence/generated"
  moduleFormat = "cjs"
  importFileExtension = "js"
}
// Part B: file submissions of rubric assignments (CAR-05, CU-04) with immutable versions and a transactional outbox.
// The submission -> current file and file -> submission foreign keys exist in SQL only (deferrable cycle).
model Submission {
  id String @id @db.Uuid
  assessmentId String @db.Uuid
  courseId String @db.Uuid
  studentId String @db.Uuid
  version Int
  currentFileId String @db.Uuid
  firstSubmittedAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  @@unique([assessmentId, studentId])
  @@index([courseId])
  @@map("submissions")
  @@schema("submissions")
}
model SubmissionFile {
  id String @id @db.Uuid
  submissionId String @db.Uuid
  version Int
  storageKey String @unique @db.VarChar(64)
  filename String @db.VarChar(180)
  mimeType String @db.VarChar(120)
  size Int
  sha256 String @db.Char(64)
  textContent String?
  receivedAt DateTime @db.Timestamptz(3)
  @@unique([submissionId, version])
  @@map("files")
  @@schema("submissions")
}
model SubmissionOutbox {
  id String @id @db.Uuid
  type String @db.VarChar(40)
  aggregateId String @db.Uuid
  payload Json
  createdAt DateTime @db.Timestamptz(3)
  availableAt DateTime @db.Timestamptz(3)
  attempts Int @default(0)
  processedAt DateTime? @db.Timestamptz(3)
  lastError String? @db.VarChar(200)
  @@index([processedAt, availableAt])
  @@map("outbox")
  @@schema("submissions")
}
// Part B: similarity reports of the SIMULATED plagiarism provider (CAR-10, CU-15).
model PlagiarismReport {
  id String @id @db.Uuid
  fileId String @unique @db.Uuid
  submissionId String @db.Uuid
  assessmentId String @db.Uuid
  courseId String @db.Uuid
  studentId String @db.Uuid
  status String @db.VarChar(12)
  similarityBp Int?
  matches Json
  provider String @db.VarChar(40)
  comparedWith Int
  createdAt DateTime @db.Timestamptz(3)
  @@index([assessmentId])
  @@map("reports")
  @@schema("plagiarism")
}
