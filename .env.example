# Run npm run setup:env to generate local secrets. Never commit .env.
POSTGRES_USER=edutrack
POSTGRES_DB=edutrack
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
JWT_SECRET=
PORT=3000
WEB_PORT=8080
WEB_ORIGIN=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=EduTrack <noreply@edutrack.test>
# Remote SMTP requires TLS. Configure user/password together if authentication is required.
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
COURSE_STORAGE_ROOT=storage/courses
# Express trust proxy for the API when it runs behind a reverse proxy (Compose sets uniquelocal). Never "true".
# TRUST_PROXY=loopback
# SIMULADO: Registro Académico de demostración (docker compose service "registry"). Without both, synchronization stays idle.
REGISTRY_URL=http://localhost:4010
REGISTRY_API_KEY=
# REGISTRY_RETRY_BASE_MS=2000
# Compose: password of the least-privilege runtime role edutrack_app (no ownership, no UPDATE/DELETE on audit).
APP_DB_PASSWORD=
WEB_TLS_PORT=8443
# API: directory (separate volume) where the audit chain head is anchored, and monitoring thresholds.
# AUDIT_ANCHOR_DIR=storage/anchors
# MONITOR_P95_MS=1000
# MONITOR_ERROR_RATE_PCT=5
# MONITOR_OUTBOX_AGE_SECONDS=120
